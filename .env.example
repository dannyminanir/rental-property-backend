# Server configuration
PORT=5000
NODE_ENV=development

# Database connection
DATABASE_URL=mongodb://localhost:27017/rental_property_db

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI LLM API Key (Keep on server, NEVER commit real key to git)
# Provider options: Gemini, OpenAI, Claude
AI_PROVIDER=gemini
AI_API_KEY=your_llm_api_key_here

# Frontend URL (for CORS and invite links)
CLIENT_URL=http://localhost:5173
